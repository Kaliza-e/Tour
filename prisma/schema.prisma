// Tour — Research Ecosystem Platform
// Optimized & Cleaned Prisma Schema reflecting the active product surface.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// USERS & AUTH
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  MENTOR
  REVIEWER
  ADMIN
}

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  emailVerified     DateTime?
  image             String?
  hashedPassword    String?
  role              Role     @default(STUDENT)

  // Profile / academic portfolio
  bio               String?
  school            String?
  gradeLevel        String?
  researchInterests String[] @default([])
  skills            String[] @default([])
  location          String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  accounts             Account[]
  sessions             Session[]

  questionsAsked       Question[]           @relation("QuestionAuthor")
  projects             ResearchProject[]    @relation("ProjectOwner")
  submissions          Submission[]
  assignedSubmissions  Submission[]         @relation("AssignedReviewer")
  submissionVersions   SubmissionVersion[]
  submissionAuthors    SubmissionAuthor[]
  reviews              Review[]
  notifications        Notification[]
  emailLogs            EmailNotificationLog[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// TAXONOMY & QUESTION HUB
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?

  questions   Question[]
  projects    ResearchProject[]
}

enum QuestionStatus {
  OPEN
  BEING_RESEARCHED
  RESEARCH_COMPLETED
  ANSWERED
}

model Question {
  id          String         @id @default(cuid())
  title       String
  description String         @db.Text
  status      QuestionStatus @default(OPEN)
  tags        String[]       @default([])
  views       Int            @default(0)

  authorId    String
  author      User           @relation("QuestionAuthor", fields: [authorId], references: [id])

  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id])

  project     ResearchProject? // set once a student adopts the question

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// RESEARCH WORKSPACE / PROJECT
// ---------------------------------------------------------------------------

enum ProjectStage {
  WORKSPACE
  RESEARCH
  DRAFT
  SUBMISSION
  PUBLICATION
}

model ResearchProject {
  id            String       @id @default(cuid())
  title         String
  researchGoal  String       @db.Text
  hypothesis    String?      @db.Text
  objectives    String[]     @default([])
  stage         ProjectStage @default(WORKSPACE)
  progress      Int          @default(0) // 0-100

  questionId    String?      @unique
  question      Question?    @relation(fields: [questionId], references: [id])

  ownerId       String
  owner         User         @relation("ProjectOwner", fields: [ownerId], references: [id])

  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id])

  notes         ResearchNote[]
  references    Reference[]
  tasks         Task[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model ResearchNote {
  id        String   @id @default(cuid())
  projectId String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Reference {
  id         String  @id @default(cuid())
  projectId  String
  citation   String  @db.Text
  url        String?

  project    ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Task {
  id        String   @id @default(cuid())
  projectId String
  title     String
  done      Boolean  @default(false)
  dueDate   DateTime?

  project   ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// SUBMISSION & PUBLICATION PIPELINE
// ---------------------------------------------------------------------------

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUESTED
  RESUBMITTED
  APPROVED
  PUBLISHED
  REJECTED
}

enum SubmissionResearchType {
  RESEARCH_ARTICLE
  STUDENT_SCIENCE_WRITING
  EXPLORATORY_ESSAY
  LITERATURE_REVIEW
  RESEARCH_PROJECT
  EXPERIMENTAL_STUDY
  OPINION_REFLECTION
  OTHER
}

enum ReviewDecision {
  APPROVE
  REQUEST_REVISION
  REJECT
}

model SubmissionAuthor {
  id            String      @id @default(cuid())
  submissionId  String
  userId        String?
  fullName      String
  email         String
  institution   String?
  country       String?
  academicLevel String?
  bio           String?     @db.Text
  createdAt     DateTime    @default(now())

  submission    Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([submissionId])
}

model Submission {
  id                   String                 @id @default(cuid())
  submissionId         String                 @unique
  userId               String
  assignedReviewerId   String?
  title                String
  abstract             String                 @db.Text
  category             String
  researchType         SubmissionResearchType @default(RESEARCH_ARTICLE)
  keywords             String[]               @default([])
  description          String?                @db.Text
  methodology          String?                @db.Text
  references           String?                @db.Text
  supportingLinks      String[]               @default([])
  authorBio            String?                @db.Text
  publicationTitle     String?
  publicationCategory  String?
  publicationSummary   String?                @db.Text
  publicationCoverImage String?
  publicationAuthorBio String?                @db.Text
  publicationDate      DateTime?
  institution          String?
  country              String?
  academicLevel        String?
  coAuthors            String[]               @default([])
  email                String
  fileUrl              String?
  fileName             String?
  fileType             String?
  status               SubmissionStatus       @default(DRAFT)
  isTermsAccepted      Boolean                @default(false)
  submittedAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  authors              SubmissionAuthor[]
  reviews              Review[]
  statusHistory        SubmissionStatusHistory[]
  publication          Publication?
  versions             SubmissionVersion[]
  assignedReviewer     User?                  @relation("AssignedReviewer", fields: [assignedReviewerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([assignedReviewerId])
}

model SubmissionVersion {
  id            String   @id @default(cuid())
  submissionId  String
  versionNumber Int
  title         String
  abstract      String   @db.Text
  description   String?  @db.Text
  methodology   String?  @db.Text
  references    String?  @db.Text
  fileUrl       String?
  fileName      String?
  fileType      String?
  createdById   String
  createdAt     DateTime @default(now())

  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdBy     User       @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([submissionId, versionNumber])
  @@index([submissionId])
}

model Review {
  id            String        @id @default(cuid())
  submissionId  String
  reviewerId    String
  decision      ReviewDecision
  feedback      String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  submission    Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer      User          @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model SubmissionStatusHistory {
  id            String           @id @default(cuid())
  submissionId  String
  previousStatus SubmissionStatus?
  newStatus     SubmissionStatus
  changedBy     String?
  note          String?          @db.Text
  createdAt     DateTime         @default(now())

  submission    Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model Publication {
  id              String      @id @default(cuid())
  submissionId    String      @unique
  title           String
  category        String
  abstract        String      @db.Text
  summary         String?     @db.Text
  coverImage      String?
  publicationDate DateTime?
  content         String?     @db.Text
  keywords        String[]    @default([])
  references      String?     @db.Text
  authorBio       String?     @db.Text
  isFeatured      Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  submission      Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS & AUDIT LOGS
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

enum EmailEvent {
  SUBMISSION_RECEIVED
  SUBMISSION_UNDER_REVIEW
  REVISION_REQUESTED
  SUBMISSION_APPROVED
  SUBMISSION_PUBLISHED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model EmailNotificationLog {
  id          String      @id @default(cuid())
  userId      String
  toEmail     String
  subject     String
  body        String      @db.Text
  event       EmailEvent
  status      EmailStatus @default(PENDING)
  provider    String?
  providerRef String?
  error       String?     @db.Text
  sentAt      DateTime?
  createdAt   DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([event])
  @@index([status])
}
